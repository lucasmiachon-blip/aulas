{
  "mcpServers": {
    "a11y-contrast": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "a11y-color-contrast-mcp"],
      "env": {}
    },
    "a11y": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "a11y-mcp-server"],
      "env": {}
    },
    "lighthouse": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "@danielsogl/lighthouse-mcp"],
      "env": {}
    },
    "perplexity": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@perplexity-ai/mcp-server"],
      "env": {
        "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
      }
    },
    "crossref": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@botanicastudios/crossref-mcp"],
      "env": {}
    },
    "frontend-review": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "frontend-review-mcp"],
      "env": {
        "HYPERBOLIC_API_KEY": "${HYPERBOLIC_API_KEY}"
      }
    },
    "frontend-design-audit": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "frontend-design-audit"],
      "env": {}
    }
  }
}
